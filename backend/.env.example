# ---- Server ----
PORT=5000
NODE_ENV=development
# Number of proxies in front of the API (Render = 1; Vercel rewrite + Render = 2)
TRUST_PROXY=0

# ---- Database ----
# Local dev: run `npm run db:local` and use the private instance below.
MONGO_URI=mongodb://127.0.0.1:27027
MONGO_DB_NAME=ride-it-dev

# ---- Auth ---- (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# ---- Frontend origins allowed to call the API (comma separated) ----
FRONTEND_URLS=http://localhost:5173
# Base URL used in password-reset emails
APP_URL=http://localhost:5173

# ---- Payments (Stripe TEST mode keys only: sk_test_...) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email for password resets (optional; without it links are printed to the console in dev) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RIDE-IT <no-reply@example.com>

# ---- Optional AI for the chat assistant (any OpenAI-compatible endpoint) ----
# Example (Groq free tier): AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.1-8b-instant
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ---- Maps ---- 'osm' = public OpenStreetMap services (Photon + OSRM), 'offline' = landmarks + estimates
GEO_PROVIDER=osm

# ---- Product ----
# Phase 1 is chauffeur rentals only. Set to true to bring back instant city rides.
RIDES_ENABLED=false
SERVICE_AREA_NAME=Varanasi
SERVICE_AREA_LAT=25.3176
SERVICE_AREA_LNG=82.9739
SERVICE_AREA_RADIUS_KM=35

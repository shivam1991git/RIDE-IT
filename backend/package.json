{
  "name": "ride-it-api",
  "version": "2.0.0",
  "description": "RIDE-IT ride booking and rentals API",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch src server.js",
    "client": "npm run dev --prefix ../frontend",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "db:local": "node scripts/local-db.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "migrate": "node scripts/migrate-and-index.js",
    "test": "jest --runInBand",
    "backup": "node scripts/backup-db.js"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.2",
    "nodemailer": "^10.3.1",
    "socket.io": "^4.8.1",
    "stripe": "^15.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/tests/setup/env.js"
    ],
    "roots": [
      "<rootDir>/tests"
    ]
  }
}

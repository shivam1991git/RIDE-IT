# Optional. Leave empty in development (Vite proxies /api and /socket.io to :5000).

# Direct URL of the API for Socket.IO in production. Vercel rewrites cannot
# proxy WebSockets, so live updates connect straight to the API host.
VITE_SOCKET_URL=

# Stripe TEST publishable key (pk_test_...). Card payments stay disabled without it.
VITE_STRIPE_PUBLISHABLE_KEY=
